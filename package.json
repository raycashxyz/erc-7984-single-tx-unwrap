{
  "name": "erc-7984-single-tx-unwrap",
  "version": "0.1.0",
  "private": true,
  "description": "One-transaction ERC-7984 unwrap from a Zama KMS user decryption: ZK proofs (Noir/UltraHonk, circom/Groth16) or revealed shares",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "vitest run",
    "gas": "vitest run test/gas.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:noir": "bash scripts/build-noir.sh",
    "build:circom": "bash scripts/build-circom.sh",
    "prove": "tsx scripts/prove.ts"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.5.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "^5.6.1",
    "encrypted-types": "^0.0.4",
    "viem": "2.44.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@deployoor/hardhat": "0.3.1",
    "@deployoor/testing": "0.3.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.15.3",
    "circomlib": "2.0.5",
    "deployoor": "0.10.0",
    "eslint": "^9.39.2",
    "ethers": "6.16.0",
    "fhevm-tevm-mocks": "0.4.1",
    "hardhat": "2.28.4",
    "snarkjs": "0.7.6",
    "tevm": "1.0.0-next.149",
    "ts-node": "10.9.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  }
}
